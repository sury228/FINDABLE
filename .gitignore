*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
eggs/
.eggs/
*.egg

# ==========================================
# Virtual Environments (DO NOT PUSH)
# ==========================================
.payvenv/
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

