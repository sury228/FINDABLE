# ==============================================================================
# Findable: Environment Configuration Template
# ==============================================================================

# PayPal Sandbox API Configuration
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# AI LLM Provider Configuration (groq, anthropic, or gemini)
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Application Settings
APP_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///findable.db
PASSPORT_SECRET=change_this_to_a_secure_random_32_byte_secret_key

# Offline Mock Mode (1 = enabled, 0 = disabled)
# When set to 1, simulates PayPal transactions without real API keys
MOCK_PAYPAL=0
